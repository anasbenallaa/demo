# syntax=docker/dockerfile:1.7
#
# Production build for THIS application, layered on top of the pre-baked runtime
# image published at nexudev/laravel-starter.
#
# That base already contains: PHP 8.4 + FrankenPHP, the compiled PHP extensions
# (pcntl, pdo_pgsql, redis, intl, zip, bcmath), Composer, Supervisor, curl, the
# non-root `app` user and the OPcache tuning. Building from it skips the slowest
# step of a cold build (compiling the PHP extensions from source), so app-only
# rebuilds take a fraction of the time.
#
# `Dockerfile` (the full build from dunglas/frankenphp) is what PRODUCES/refreshes
# that base image. This file CONSUMES it to produce the deployable app image.
#
#   docker build -f Dockerfile.production -t <registry>/<app>:<tag> .
#   # multi-arch is not possible here unless the base is multi-arch; it is linux/amd64.

ARG RUNTIME_IMAGE=nexudev/laravel-starter:latest
ARG NODE_IMAGE=node:22-bookworm-slim

# Plain FROM: buildx resolves this to the build's target platform, matching the
# stages that consume the copied Node binary. (The runtime base is multi-arch.)
FROM ${NODE_IMAGE} AS node

# ---------------------------------------------------------------------------
# Stage 1: Composer dependencies — production only, authoritative autoloader.
# ---------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS vendor

ENV COMPOSER_ALLOW_SUPERUSER=1
USER root
RUN rm -rf /app && mkdir -p /app
WORKDIR /app

# Manifests first so this layer caches until composer.json / composer.lock change.
COPY composer.json composer.lock ./
RUN composer install \
        --no-dev --no-scripts --no-autoloader \
        --prefer-dist --no-interaction --no-progress

COPY . .
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative --no-interaction

# ---------------------------------------------------------------------------
# Stage 2: front-end assets — Vite + Wayfinder.
# PHP is already in the base; Node is copied in for the build only.
# ---------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS frontend

USER root
RUN rm -rf /app && mkdir -p /app
WORKDIR /app

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Vendor dir is needed so `php artisan wayfinder:generate` can boot during the build.
COPY --from=vendor /app/vendor ./vendor

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
# Throwaway .env / APP_KEY only lets artisan boot for Wayfinder; deleted right after.
RUN set -eux; \
    cp .env.example .env; \
    php artisan key:generate --force; \
    npm run build; \
    rm -f .env

# ---------------------------------------------------------------------------
# Stage 3: final production image.
# ---------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS app

# Replace the app baked into the base image with this build's code.
USER root
RUN rm -rf /app && mkdir -p /app
WORKDIR /app

COPY --chown=app:app . .
COPY --from=vendor   --chown=app:app /app/vendor       ./vendor
COPY --from=frontend --chown=app:app /app/public/build ./public/build

# Keep the repo as the source of truth for the runtime config, even if the
# base image was published with older copies.
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/z-opcache.ini
COPY docker/supervisor/supervisord.conf /etc/supervisor/supervisord.conf
COPY docker/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

RUN set -eux; \
    mkdir -p \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache; \
    chown -R app:app storage bootstrap/cache; \
    chmod -R ug+rwX storage bootstrap/cache

USER app

# Run database migrations on container start (entrypoint calls
# `php artisan migrate --force --isolated`; --isolated takes a cache lock so
# that in a scaled deployment only one replica migrates and the rest wait).
# Override at deploy time with `-e RUN_MIGRATIONS=false` to make migrations an
# explicit, separate step instead.
ENV APP_ENV=production \
    APP_DEBUG=false \
    RUN_MIGRATIONS=true \
    WAIT_FOR_DB=true \
    OCTANE_SERVER=frankenphp \
    OCTANE_WORKERS=auto \
    OCTANE_MAX_REQUESTS=500

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8000/up || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD ["supervisord", "-c", "/etc/supervisor/supervisord.conf"]
